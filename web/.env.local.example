NEON_AUTH_BASE_URL=https://<your-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# openssl rand -base64 32 se banao, commit mat karna
NEON_AUTH_COOKIE_SECRET=REPLACE_ME_with_openssl_rand_base64_32
# FastAPI backend ka URL (browser se reachable hona chahiye)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser-side Auth URL — NEON_AUTH_BASE_URL ke barabar rakho
NEXT_PUBLIC_NEON_AUTH_URL=https://<your-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
