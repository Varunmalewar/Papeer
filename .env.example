# ── Papeer — Required Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# LLM (OpenAI gpt-4o-mini — routing, answers, critic, session naming, /btw)
OPENAI_API_KEY=

# Optional LLM fallback when OPENAI_API_KEY is unset (Xkiro / Groq)
# XKIRO_API_KEY=
# GROQ_API_KEY=

# Embeddings (Google Gemini — gemini-embedding-2, 1536 dims)
GOOGLE_API_KEY=

# Web search (Tavily — used for live search and claim verification)
TAVILY_API_KEY=

# Vector store (Qdrant Cloud)
QDRANT_URL=
QDRANT_API_KEY=

# ── Neon Postgres (embedding cache) ─────────────────────────────────────────
# Pooled URL for app traffic (via `neon env pull`). When set, the embedding
# cache lives in the `embedding_cache` table; otherwise LocalFileStore is used.
# DATABASE_URL=
# Direct URL for migrations / admin (optional).
# DATABASE_URL_UNPOOLED=

# ── Optional ──────────────────────────────────────────────────────────────────

# ── Neon Auth (Better Auth JWT — FastAPI verifies via JWKS) ───────────────────
# Backend already reads these (api/auth.py). Get values from Neon Console →
# Project → Branch → Better Auth → Settings (tumhara screenshot wala page).
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Frontend (web/.env.local) needs the same two + NEON_AUTH_COOKIE_SECRET +
# NEXT_PUBLIC_NEON_AUTH_URL (= base URL) — see web/.env.local.example.

# ── API auth + rate limit ───────────────────────────────────────────────────────
# PAPEER_API_KEY: shared key clients send as X-API-Key header (fail-closed if unset).
PAPEER_API_KEY=
# Requests allowed per minute per key/IP (in-memory sliding window).
# PAPEER_RATE_LIMIT_PER_MIN=20

# Set to "1" to show raw graph state in the UI (developer debugging)
# PAPEER_DEBUG=1


# ── Hybrid search tuning (dense Gemini + in-memory BM25 + RRF) ────────────────
# No Qdrant reindex needed. search() tries hybrid first, falls back to dense.
# PAPEER_HYBRID_DENSE_K=20
# PAPEER_HYBRID_BM25_K=20
# PAPEER_HYBRID_MAX_DOCS=500
# PAPEER_HYBRID_RRF_K=60
# Evidence packaging: hybrid search + rerank, top PRIMARY_K chunks, then drop any
# chunk scoring below REL_CUTOFF x the best rerank score (dynamic k). Only if that
# finds nothing usable does retrieval fall back to query variants + BM25 rescue
# (which keeps FINAL_EVIDENCE_K chunks).
# PAPEER_PRIMARY_K=5
# PAPEER_REL_CUTOFF=0.7
# PAPEER_FINAL_EVIDENCE_K=3
# Tables: pages with a "Table N:" caption or a ruled table are re-read by Docling
# (markdown tables) when the optional extra is installed: `uv sync --extra docling`.
# ~9 s per table page, ~1.5 GB RAM, ingestion only. 0 forces plain PyMuPDF text.
# PAPEER_DOCLING=1
# PAPEER_MULTIHOP_CANDIDATE_K=12
# PAPEER_MULTIHOP_FINAL_EVIDENCE_K=6

# ── Figures (captions + images from PDFs) ────────────────────────────────────
# PAPEER_FIGURES=1                 # 0 disables figure extraction entirely
# PAPEER_FIGURE_DIR=./data/figures # where extracted figure images are stored
# PAPEER_PDF_DIR=./data/pdfs       # where uploaded/arXiv source PDFs are stored
# PAPEER_PERSIST_PDFS=1            # 0 keeps the old "delete temp PDF" behaviour
# PAPEER_FIG_MIN_W=200             # skip images narrower than this (px)
# PAPEER_FIG_MIN_H=120             # skip images shorter than this (px)
# PAPEER_FIG_MIN_AREA_FRAC=0.02    # skip placements smaller than this page fraction
# PAPEER_FIG_REF_CHARS=600         # max chars of in-text references kept per figure
# Vision descriptions are OFF by default (extra tokens at ingestion time only;
# results are cached by image hash so re-ingesting never re-calls the model).
# PAPEER_FIGURE_DESCRIPTIONS=0
# PAPEER_VISION_MODEL=gpt-4o-mini
# PAPEER_FIGURE_CACHE_DB=./data/figure_descriptions.sqlite
# Attach original figure images to answer generation for top figure hits.
# PAPEER_ATTACH_FIGURE_IMAGES=0
# URL prefix for figure chips in the UI (proxied by the web app).
# PAPEER_FIGURE_URL_PREFIX=/api/figure

# ── Docker ────────────────────────────────────────────────────────────────────
# Build:  docker compose build
# Run:    docker compose up -d        (reads .env via env_file, persists cache vol)
# Logs:   docker compose logs -f
# API:    http://localhost:8000/health
# Web:    http://localhost:3000
